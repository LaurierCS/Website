# Supabase settings for the public site, the same names as the admin's. The site reads them when it builds.
# DATABASE_URL is the Supabase project URL (https://<project-ref>.supabase.co), not a Postgres connection string.
# DATABASE_KEY is the anon (publishable) key. Never put the service role key or a database password here.
DATABASE_URL=
DATABASE_KEY=
