---
import ComingUp from '../components/events/ComingUp.astro';
import Hero from '../components/hero/Hero.astro';
import MtpSpotlight from '../components/mtp/MtpSpotlight.astro';
import EverythingElse from '../components/posters/EverythingElse.astro';
import { EVENTS } from '../content/events';
import { EVERYTHING_ELSE, KIND_NAMES, POSTER_ROWS } from '../content/everything-else';
import { MTP, SPEAKERS } from '../content/mtp';
import BaseLayout from '../layouts/BaseLayout.astro';
import { clubToday } from '../lib/dates';
import { upcomingEvents } from '../lib/events';

// Worked out when the page is built. Once the events table feeds the page it is rendered per visit instead.
const today = clubToday();
const upcoming = upcomingEvents(EVENTS, today);
---

<BaseLayout
  title="Laurier Computing Society"
  description="Wilfrid Laurier's computer science club: midterm reviews, Meet the Professionals, hackathons and a community that codes together."
>
  <Hero nextEvent={upcoming[0]} />
  <ComingUp events={EVENTS} upcoming={upcoming} today={today} />
  <MtpSpotlight copy={MTP} speakers={SPEAKERS} />
  {/* Until the posters sheet has a row, there is nothing to show here. */}
  {POSTER_ROWS.length > 0 && <EverythingElse copy={EVERYTHING_ELSE} names={KIND_NAMES} rows={POSTER_ROWS} />}
</BaseLayout>
