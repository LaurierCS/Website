---
import ComingUp from '../components/events/ComingUp.astro';
import Hero from '../components/hero/Hero.astro';
import MtpSpotlight from '../components/mtp/MtpSpotlight.astro';
import EverythingElse from '../components/posters/EverythingElse.astro';
import Resources from '../components/resources/Resources.astro';
import TeamCredits from '../components/team/TeamCredits.astro';
import { EVENTS } from '../content/events';
import { EVERYTHING_ELSE, KIND_NAMES } from '../content/everything-else';
import { MTP, SPEAKERS } from '../content/mtp';
import { RESOURCES } from '../content/resources';
import { TEAM } from '../content/team';
import BaseLayout from '../layouts/BaseLayout.astro';
import { clubToday } from '../lib/dates';
import { upcomingEvents } from '../lib/events';
import { postersByKind } from '../lib/posters';
import { listEventPosters } from '../lib/queries/events';
import { listPublicTeam } from '../lib/queries/team';
import { crews } from '../lib/team';

// Worked out when the page is built. Once the events table feeds the page it is rendered per visit instead.
const today = clubToday();
const upcoming = upcomingEvents(EVENTS, today);
// The event posters and the public team, from the events and team tables, read when the page is built. If
// Supabase can't be reached the build stops, rather than going live with empty sections.
const [posterRows, teamCrews] = await Promise.all([
  listEventPosters().then(postersByKind),
  listPublicTeam().then(crews),
]);
---

<BaseLayout
  title="Laurier Computing Society"
  description="Wilfrid Laurier's computer science club: midterm reviews, Meet the Professionals, hackathons and a community that codes together."
>
  <Hero nextEvent={upcoming[0]} />
  <ComingUp events={EVENTS} upcoming={upcoming} today={today} />
  <MtpSpotlight copy={MTP} speakers={SPEAKERS} />
  {/* Until an event has a kind and a poster in the admin, there is nothing to show here. */}
  {posterRows.length > 0 && <EverythingElse copy={EVERYTHING_ELSE} names={KIND_NAMES} rows={posterRows} />}
  <Resources content={RESOURCES} />
  {/* Until an exec makes someone public in the admin, there is nobody to credit. */}
  {teamCrews.length > 0 && <TeamCredits copy={TEAM} crews={teamCrews} />}
</BaseLayout>
