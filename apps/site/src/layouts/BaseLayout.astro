---
/**
 * The page shell every page shares: the document head, the brand styles, the header and the footer.
 */
import dosis from '@fontsource-variable/dosis/files/dosis-latin-wght-normal.woff2?url';
import montserrat from '@fontsource-variable/montserrat/files/montserrat-latin-wght-normal.woff2?url';
import SiteFooter from '../components/layout/SiteFooter.astro';
import SiteNav from '../components/layout/SiteNav.astro';
import pageArrival from '../scripts/page-arrival.js?raw';
import '../styles/global.css';

// The brand fonts, fetched alongside the page instead of after the CSS asks for them. Without this the page first
// draws in a stand-in font and then jumps when Dosis and Montserrat arrive. Same files the CSS uses (Latin only).
const PRELOADED_FONTS = [dosis, montserrat];

type Props = { title: string; description: string };

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    {/*
      Hide the page until `page-arrival` (at the end of the page) has it ready to show in its final place, and
      let that script, not the browser, put the scroll back on a refresh, so it happens before the page shows.
    */}
    <script is:inline>
      document.documentElement.toggleAttribute('data-arriving', true);
      history.scrollRestoration = 'manual';
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#121a2b" />
    {PRELOADED_FONTS.map((font) => <link rel="preload" href={font} as="font" type="font/woff2" crossorigin />)}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <SiteNav />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
    {/* Inline, so it runs as soon as the page has been read, rather than after everything has loaded. */}
    <script is:inline set:html={pageArrival} />
  </body>
</html>
