---
import { MASCOTS } from '../../lib/brand-assets';
import { startsInLabel } from '../../lib/dates';
import { DISCORD_URL } from '../../lib/site';
import type { EventRecord } from '../../lib/queries/events';
import Stats from './Stats.astro';

interface Props {
  next: EventRecord | null;
}

const { next } = Astro.props;
---
<section class="hero" id="about">
  <div class="wrap">
    <div class="hero-grid">
      <div data-reveal>
        <p class="eyebrow b">Wilfrid Laurier University's CS club · since 2012</p>
        <h1>Laurier Computing Society</h1>
        <p class="hero-line">Learn, build and meet people who <span class="hl">love computing.</span></p>
        <p class="sub">Midterm reviews, workshops, industry nights and hackathons, run by students for students.</p>
        <div class="hero-ctas">
          <a class="btn btn-primary" href="#events">See upcoming events</a>
          <a class="btn btn-secondary" href={DISCORD_URL}>Join the Discord</a>
        </div>
      </div>
      <div class="next" data-reveal style="--d:80ms">
        <img class="krill" data-parallax="18" src={MASCOTS.krill} alt="Krill the mascot" />
        <div class="window">
          <div class="window-bar"><i></i><i></i><i></i><span>next_event.js</span></div>
          {next ? (
            <pre><span class="c-c">// the next thing happening at LCS</span>{'\n'}<span class="c-k">const</span> nextEvent = {'{\n'}  <span class="c-p">title</span>: <span class="c-s">"{next.title}"</span>,{'\n'}  <span class="c-p">when</span>:  <span class="c-s">"{next.time?.trim() || 'Time TBA'}"</span>,{'\n'}  <span class="c-p">where</span>: <span class="c-s">"{next.location?.trim() || 'Location TBA'}"</span>,{'\n'}{'}'};</pre>
          ) : (
            <pre><span class="c-c">// nothing on the calendar yet</span>{'\n'}<span class="c-k">const</span> nextEvent = <span class="c-n">null</span>;</pre>
          )}
          <div class="next-foot">
            {next ? (
              <span class="countdown" data-countdown data-date={next.date} data-time={next.time ?? ''}>
                {startsInLabel(next.date)}
              </span>
            ) : (
              <span class="countdown">Check back soon</span>
            )}
            <a class="btn btn-primary btn-sm" href={next ? `/events/${next.id}` : '/events'}>
              {next ? 'View event →' : 'All events →'}
            </a>
          </div>
        </div>
      </div>
    </div>
    <Stats />
  </div>
</section>
