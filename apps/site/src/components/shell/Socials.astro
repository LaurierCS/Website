---
<div class="socials">
  {SOCIALS.map((social) => (
    <a href={social.url} target="_blank" rel="noopener noreferrer" aria-label={social.name} title={social.name} data-social>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d={paths[social.name]} /></svg>
    </a>
  ))}
</div>
<script>
  import { ACCENTS } from '../../lib/site';
  document.querySelectorAll<HTMLAnchorElement>('[data-social]').forEach((link) => {
    let last = '';
    link.addEventListener('mouseenter', () => {
      const pool = ACCENTS.filter((color) => color !== last);
      const next = pool[Math.floor(Math.random() * pool.length)] ?? ACCENTS[0];
      last = next;
      link.style.color = next;
    });
    link.addEventListener('mouseleave', () => {
      link.style.color = '';
    });
  });
</script>
