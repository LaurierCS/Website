---
/**
 * The home page's "Missed it? It's all here.": what the club keeps for anyone who missed a night (recordings,
 * practice questions, starter code), each a link to where it all lives, beside the clubroom laptop showing the
 * newest of each, with Krill standing by it, who tapes over its camera. `scripts/clubroom-laptop.ts` runs the
 * laptop's tabs and Krill.
 */
import { Image } from 'astro:assets';
import { MASCOTS } from '../../assets/brand';
import { RESOURCE_KINDS, type RESOURCES } from '../../content/resources';
import { linkTarget } from '../../lib/links';
import ClubroomLaptop from './ClubroomLaptop.astro';
import { RESOURCE_ICONS, RESOURCE_TINT } from './resource-icons';
import { DOODLE_SPOTS } from '../ui/doodle-spots';
import Doodles from '../ui/Doodles.astro';

type Props = { content: typeof RESOURCES };

const { content } = Astro.props;
---

<clubroom-laptop class="group relative isolate block overflow-x-clip">
  <Doodles spots={DOODLE_SPOTS.resources} />
  <section
    id="resources"
    aria-labelledby="resources-title"
    class="mx-auto grid max-w-(--max) grid-cols-1 items-center gap-10 px-4 py-16 nav:px-16 nav:py-24 xl:grid-cols-[auto_minmax(0,1fr)] xl:gap-16"
  >
    {/*
      On a wide screen the words sit on the right and the laptop on the left, the other way round from the
      sections around it.
    */}
    <header class="flex flex-col gap-4 xl:order-2">
      <p class="font-display text-sm font-bold tracking-label text-sky uppercase">{content.label}</p>
      <h2 id="resources-title" class="text-4xl leading-none font-extrabold text-balance nav:text-6xl">
        {content.title}
      </h2>
      <p class="max-w-prose text-text-2 nav:text-lg">{content.summary}</p>
      <ul class="mt-1 flex flex-col gap-2.5">
        {
          RESOURCE_KINDS.map((kind) => {
            const Icon = RESOURCE_ICONS[kind];
            const { href, label } = content.kinds[kind];
            return (
              <li>
                <a
                  href={href}
                  {...linkTarget(href)}
                  class="group/kind inline-flex items-center gap-2.5 font-display text-lg font-bold"
                >
                  <Icon class:list={['size-5', RESOURCE_TINT[kind]]} aria-hidden="true" />
                  <span class="underline decoration-transparent underline-offset-4 transition-[text-decoration-color] duration-(--dur-fast) group-hover/kind:decoration-current">
                    {label}
                  </span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </header>

    {/* Its own stacking layer, so Krill can be drawn behind the laptop and peek over its top edge. */}
    <div class="relative isolate min-w-0 nav:justify-self-center xl:order-1 xl:justify-self-start">
      <ClubroomLaptop content={content} />
      {/*
        Krill, behind the laptop: the first time it comes into view he pops up over its top and tapes up its
        camera (`scripts/clubroom-laptop.ts` moves him from here).
      */}
      <Image
        data-krill
        src={MASCOTS.krill}
        alt=""
        width={104}
        densities={[1, 2]}
        class="absolute -top-14 right-1 -z-10 h-auto w-14 nav:top-auto nav:-right-8 nav:-bottom-6 nav:w-26"
      />
    </div>
  </section>
</clubroom-laptop>

<script>
  import '../../scripts/clubroom-laptop';
</script>
