---
/**
 * The laptop's recording tab, laid out like a YouTube watch page: the channel's newest upload as a thumbnail with
 * a red play button and the bar that fills as you watch, a "New" sticker slapped on its corner, then the title
 * beside the channel's LCS avatar. The whole thing opens the video on YouTube.
 */
import { Image } from 'astro:assets';
import type { Recording } from '../../content/resources';
import { fullDate } from '../../lib/dates';
import { linkTarget } from '../../lib/links';

type Props = { recording: Recording };

const { recording } = Astro.props;
const href = `https://www.youtube.com/watch?v=${recording.videoId}`;
---

<a href={href} {...linkTarget(href)} class="group/video flex h-full flex-col">
  <span class="relative grid aspect-video place-items-center overflow-hidden bg-window">
    <Image
      src={recording.thumbnail}
      alt=""
      widths={[400, 720]}
      sizes="(min-width: 64rem) 38rem, 100vw"
      class="absolute inset-0 size-full object-cover transition-[scale] duration-(--dur-base) ease-(--ease-out) group-hover/video:scale-103 motion-reduce:transition-none"
    />
    <span
      class="relative grid h-11 w-15 place-items-center rounded-xl bg-youtube text-white shadow-(--shadow-card) transition-[scale] duration-(--dur-fast) ease-(--ease-spring) group-hover/video:scale-110 motion-reduce:transition-none nav:h-14 nav:w-19"
      aria-hidden="true"
    >
      <svg class="size-5 nav:size-6" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
    </span>
    {/* Slapped on like a sticker: the newest one. */}
    <span
      class="absolute top-2.5 left-2.5 -rotate-6 rounded-md bg-yellow px-2 py-0.5 font-display text-xs font-extrabold tracking-label text-ink uppercase shadow-(--shadow-card) nav:top-3.5 nav:left-3.5 nav:text-sm"
    >
      New
    </span>
    {/* The watched-so-far bar along the bottom, a little way in. */}
    <span class="absolute inset-x-0 bottom-0 h-1 bg-white/30" aria-hidden="true">
      <span class="block h-full w-1/3 bg-youtube"></span>
    </span>
  </span>

  <span class="flex items-start gap-3 px-3.5 py-2.5 nav:px-4 nav:py-3.5">
    <img src="/favicon.svg" alt="" width="36" height="36" class="size-8 shrink-0 rounded-full bg-white p-1 nav:size-9" />
    <span class="flex min-w-0 flex-col gap-0.5">
      <span class="font-display text-base leading-tight font-extrabold nav:text-lg">{recording.title}</span>
      <span class="text-xs text-text-2">Laurier Computing Society · {fullDate(recording.published)}</span>
    </span>
  </span>
</a>
