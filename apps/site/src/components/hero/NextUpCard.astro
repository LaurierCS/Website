---
/**
 * The "Next up" card resting on the clubhouse floor: a little calendar page for the date, then the event, then an
 * arrow that nudges forward when you point at the card. It jumps to that event's ticket in "Coming up".
 */
import type { ClubEvent } from '../../content/events';
import { dayOfMonth, monthName, posterTime, weekdayName } from '../../lib/dates';
import { ACCENT_FILL, TICKET_ACCENTS } from '../events/event-accents';

// The same colour as the soonest event's ticket in "Coming up", so the card and the ticket it jumps to match.
const fill = ACCENT_FILL[TICKET_ACCENTS[0]];

type Props = { event: ClubEvent; class?: string };

const { event, class: className } = Astro.props;
const details = [
  `${weekdayName(event.date)} ${event.time ? posterTime(event.time) : 'time TBA'}`,
  event.location ?? 'location TBA',
].join(' · ');
---

<a
  href={`#event-${event.id}`}
  class:list={[
    'group flex items-center gap-3 rounded-(--radius-window) bg-chip py-2.5 pr-4 pl-3.5 shadow-(--shadow-card) transition-[translate] duration-(--dur-fast) ease-(--ease-spring) hover:-translate-y-1 active:translate-y-0 motion-reduce:hover:translate-y-0',
    className,
  ]}
>
  <span class:list={['flex flex-col items-center rounded-xl px-2.5 py-1.5 font-display text-ink', fill]}>
    <span class="text-xs font-bold uppercase">{monthName(event.date)}</span>
    <span class="text-2xl leading-none font-extrabold">{dayOfMonth(event.date)}</span>
  </span>
  <span class="flex flex-col">
    <span class="font-display text-xs font-bold tracking-label text-yellow uppercase">Next up</span>
    <span class="font-display text-lg font-extrabold">{event.title}</span>
    <span class="text-xs text-text-2">{details}</span>
  </span>
  <svg
    class="ms-auto size-5 shrink-0 text-yellow transition-[translate] duration-(--dur-fast) ease-(--ease-spring) group-hover:translate-x-1"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M5 12h14M13 6l6 6-6 6" />
  </svg>
</a>
