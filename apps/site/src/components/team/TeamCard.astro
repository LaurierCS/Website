---
import type { TeamMember } from '../../lib/queries/team';

interface Props {
  member: TeamMember;
}

const { member } = Astro.props;

// Assign colors based on role
let borderColor = '#FF9FC4'; // Default pink for everyone else
if (member.role) {
  const roleLower = member.role.toLowerCase();
  if (roleLower.includes('president')) {
    borderColor = '#FFD670'; // Yellow for presidents
  } else if (roleLower.includes('vice president') || roleLower.includes('vp')) {
    borderColor = '#268AF9'; // Blue for vice presidents
  }
}

const initial = member.name.trim().charAt(0).toUpperCase() || '?';
---
<article class="team-card" data-team-card style={`--border-color:${borderColor}`}>
  <div class="avatar">
    {member.picture_url ? (
      <img src={member.picture_url} alt={member.name} />
    ) : (
      <span>{initial}</span>
    )}
  </div>
  <div class="info">
    <h4>{member.name}</h4>
    {member.role && <p class="role">{member.role}</p>}
    {(member.github_url || member.linkedin_url) && (
      <div class="team-links">
        {member.github_url && (
          <a href={member.github_url} target="_blank" rel="noopener noreferrer" title="GitHub">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c2.6-.4 5.6-1.3 5.6-6a4.7 4.7 0 0 0-1.3-3.3 4.4 4.4 0 0 0-.1-3.3s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.4 4.4 0 0 0-.1 3.3A4.7 4.7 0 0 0 4 9.5c0 4.6 3 5.6 5.6 6a4.8 4.8 0 0 0-1 3.5v4"></path>
              <path d="M9 18c-4.51 2-5-2.5-7-2.5"></path>
            </svg>
          </a>
        )}
        {member.linkedin_url && (
          <a href={member.linkedin_url} target="_blank" rel="noopener noreferrer" title="LinkedIn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
              <rect x="2" y="9" width="4" height="12"></rect>
              <circle cx="4" cy="4" r="2"></circle>
            </svg>
          </a>
        )}
      </div>
    )}
  </div>
</article>
<script>
  import '../../scripts/team-card';
</script>
