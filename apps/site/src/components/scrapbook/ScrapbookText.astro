---
import { SCRAPBOOK_LETTERS } from '../../lib/brand-assets';

interface Props {
  text: string;
  size?: number;
  class?: string;
}

const { text, size = 68, class: className } = Astro.props;
const upper = text.toUpperCase();
// Falls back to plain text when a letter has no scrapbook image yet.
const lettersOk = [...upper].every((char) => char === ' ' || SCRAPBOOK_LETTERS.has(char));
const words = upper.split(/\s+/).filter(Boolean);
---
{lettersOk ? (
  <div class:list={['scrapbook', className]} data-scrapbook style={`--letter-desktop:${size}px`}>
    {words.map((word, index) => (
      <>
        {index > 0 && <span class="scrapbook-gap" aria-hidden="true"></span>}
        <span class="scrapbook-word">
          {[...word].map((letter) => (
            <img src={SCRAPBOOK_LETTERS.get(letter)} alt="" data-letter width={size} height={size} />
          ))}
        </span>
      </>
    ))}
    <span class="sr-only">{text}</span>
  </div>
) : (
  <span class:list={['scrapbook-fallback', className]} style={`--letter-desktop:${size}px`}>{text}</span>
)}
<script>
  import '../../scripts/scrapbook';
</script>
