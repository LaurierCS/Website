---
import type { EventRecord } from '../../lib/queries/events';
import { resourcesFor, seriesDocsFor, stubFor } from '../../lib/todo-data';

interface Props {
  event: EventRecord;
}

const { event } = Astro.props;
const resources = resourcesFor(event.id);
const prior = seriesDocsFor(event.id);
const series = stubFor(event.id)?.series;
const preview = [...resources, ...prior].some((row) => row.placeholder);
---
<div class="ev-main">
  <div class="card">
    <h3>About this event</h3>
    <p class="about">{event.description?.trim() || 'A description for this event is coming soon.'}</p>
  </div>

  <div class="card">
    <h3>Resources from this event</h3>
    {resources.length === 0 ? (
      <p class="soon">Slides, practice sets and recordings will land here once event resources exist.</p>
    ) : (
      <div class="res-list">
        {resources.map((row) => (
          <a class="res-row" href={row.url}>
            <span class="ficon" style={row.kind === 'video' ? 'background:var(--pink)' : undefined}>{row.kind}</span>
            <span class="info"><b>{row.title}</b><small>{row.note}</small></span>
            <span class="act">Open ↗</span>
          </a>
        ))}
      </div>
    )}
    {resources.find((row) => row.kind === 'video')?.url && (
      <div class="rec" style={`background-image:url("${event.picture_url ?? ''}")`}></div>
    )}
  </div>

  <div class="card">
    <h3>{series ? `From earlier ${series} events` : 'From earlier in the series'}</h3>
    {prior.length === 0 ? (
      <p class="soon">Older material from the same series shows up here after events.series exists.</p>
    ) : (
      <div class="res-list">
        {prior.map((row) => (
          <a class="res-row" href={row.url}>
            <span class="ficon">{row.kind}</span>
            <span class="info"><b>{row.title}</b><small>{row.note}</small></span>
            <span class="act">Open ↗</span>
          </a>
        ))}
      </div>
    )}
    {preview && <p class="note" style="margin-top:12px">Marked preview. Not a live file.</p>}
  </div>
</div>
