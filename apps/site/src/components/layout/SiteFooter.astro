---
/**
 * The footer at the bottom of every page: who made the site, with a little pink heart, and the copyright. The year
 * is the club's (Toronto's) year when the site is built, so it moves on by itself.
 */
import { FOOTER } from '../../content/footer';
import { clubToday } from '../../lib/dates';
import { linkTarget } from '../../lib/links';

const year = clubToday().slice(0, 4);
---

<footer class="border-t border-line-quiet">
  <div
    class="mx-auto flex max-w-(--max) flex-col items-center gap-2 px-4 py-8 text-center text-sm text-muted nav:flex-row nav:justify-between nav:px-16 nav:text-start"
  >
    <p class="flex flex-wrap items-center justify-center gap-1.5">
      {FOOTER.madeWith}
      <svg class="size-4 text-pink" viewBox="0 0 24 24" fill="currentColor" role="img" aria-label="love">
        <path d="M12 21s-7.5-4.6-9.6-9.2C.9 8.4 2.9 4.5 6.6 4.5c2.2 0 3.8 1.2 5.4 3.1 1.6-1.9 3.2-3.1 5.4-3.1 3.7 0 5.7 3.9 4.2 7.3C19.5 16.4 12 21 12 21Z" />
      </svg>
      {FOOTER.madeBy}
      <a
        href={FOOTER.team.href}
        {...linkTarget(FOOTER.team.href)}
        class="font-display font-bold text-text-2 underline decoration-transparent underline-offset-4 transition-colors duration-(--dur-fast) hover:text-white hover:decoration-current"
      >
        {FOOTER.team.label}
      </a>
    </p>
    <p>{FOOTER.copyright(year)}</p>
  </div>
</footer>
