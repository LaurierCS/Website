---
/**
 * The site header: the logo, then the page links and the club's accounts. Below the `nav` width there isn't room
 * for all of it, so the links move into the phone menu.
 */
import Logo from '../../assets/logos/lcs-long-white.svg';
import { PAGE_LINKS } from '../../lib/site';
import MobileMenu from './MobileMenu.astro';
import SocialLinks from './SocialLinks.astro';
---

<header class="mx-auto flex max-w-(--max) items-center justify-between px-4 py-3 nav:px-16 nav:py-5">
  <a href="/" aria-label="Laurier Computing Society home" class="rounded-md">
    <Logo class="h-12 w-auto" aria-hidden="true" />
  </a>

  <nav aria-label="Main" class="hidden items-center gap-7 nav:flex">
    <ul class="flex items-center gap-7">
      {
        PAGE_LINKS.map((page) => (
          <li>
            <a
              href={page.href}
              class="inline-block rounded-md font-display text-lg font-bold transition-[translate,color] duration-(--dur-fast) ease-(--ease-spring) hover:-translate-y-0.5 hover:text-yellow motion-reduce:hover:translate-y-0"
            >
              {page.label}
            </a>
          </li>
        ))
      }
    </ul>
    <span class="h-7 w-0.5 rounded-full bg-line-quiet" aria-hidden="true"></span>
    <SocialLinks variant="header" />
  </nav>

  <MobileMenu />
</header>
