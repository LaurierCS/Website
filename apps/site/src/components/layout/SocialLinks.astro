---
/**
 * The club's five accounts as icon links. In the header they are bare icons; in the phone menu each sits on a
 * round chip with its name under it, since there is room and a thumb needs the bigger target. Each opens in a
 * new tab.
 */
import { linkTarget } from '../../lib/links';
import { SOCIAL_LINKS } from '../../lib/site';
import { SOCIAL_HOVER_TEXT, SOCIAL_ICONS } from '../ui/social-icons';

type Props = { variant: 'header' | 'menu' };

const { variant } = Astro.props;

// Hover lifts the icon and turns it that network's own colour.
const linkMotion =
  'transition-[translate,scale,color] duration-(--dur-fast) ease-(--ease-spring) hover:-translate-y-0.5 active:scale-95 motion-reduce:transition-colors motion-reduce:hover:translate-y-0';
---

{
  variant === 'header' ? (
    <ul class="flex items-center gap-1">
      {SOCIAL_LINKS.map((link) => {
        const Icon = SOCIAL_ICONS[link.name];
        return (
          <li>
            <a
              href={link.href}
              {...linkTarget(link.href)}
              aria-label={link.description}
              class:list={['grid size-11 place-items-center rounded-full text-white', linkMotion, SOCIAL_HOVER_TEXT[link.name]]}
            >
              <Icon class="size-6" aria-hidden="true" />
            </a>
          </li>
        );
      })}
    </ul>
  ) : (
    <ul class="flex justify-between">
      {SOCIAL_LINKS.map((link) => {
        const Icon = SOCIAL_ICONS[link.name];
        return (
          <li>
            <a
              href={link.href}
              {...linkTarget(link.href)}
              aria-label={link.description}
              class:list={['group flex w-15 flex-col items-center gap-1.5 text-white', linkMotion, SOCIAL_HOVER_TEXT[link.name]]}
            >
              <span class="grid size-13 place-items-center rounded-full bg-chip">
                <Icon class="size-6.5" aria-hidden="true" />
              </span>
              <span class="font-display text-xs font-bold text-text-2 group-hover:text-current" aria-hidden="true">
                {link.label}
              </span>
            </a>
          </li>
        );
      })}
    </ul>
  )
}
