---
/**
 * The phone menu: a Menu button that opens `menu.html`, a code window like the hero's about chat, holding
 * the page links and the club's accounts. It is a modal <dialog>, so the browser handles Escape, keeping focus
 * inside and putting it on top of everything.
 */
// A plain image rather than inline SVG: the logo is big, and the header and the menu would each repeat it.
import logo from '../../assets/logos/lcs-long-white.svg?url';
import { PAGE_LINKS } from '../../lib/site';
import CodeWindow from '../ui/CodeWindow.astro';
import SocialLinks from './SocialLinks.astro';

const pill =
  'inline-flex min-h-11 items-center gap-2 rounded-full px-4 font-display text-base font-bold transition-[scale] duration-(--dur-fast) ease-(--ease-spring) active:scale-95';
---

<site-menu class="nav:hidden">
  <button
    type="button"
    data-menu-open
    aria-haspopup="dialog"
    aria-controls="site-menu"
    class:list={[pill, 'border-2 border-line-quiet bg-raised text-white hover:border-line']}
  >
    Menu
    <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <path d="M4 6h16M4 12h16M4 18h16" />
    </svg>
  </button>

  <dialog
    id="site-menu"
    aria-label="Menu"
    class="m-0 h-dvh max-h-none w-full max-w-none bg-transparent p-4 pt-3 text-white backdrop:bg-(--backdrop)"
  >
    <div class="flex items-center justify-between">
      <a href="/" aria-label="Laurier Computing Society home">
        <img src={logo} alt="" width="168" height="48" class="h-12 w-auto" />
      </a>
      <button type="button" data-menu-close class:list={[pill, 'bg-yellow text-ink']}>
        Close
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>

    <CodeWindow
      fileName="menu.html"
      class="mt-3 shadow-(--shadow-float) transition-[opacity,translate] duration-(--dur-base) ease-brand starting:-translate-y-2 starting:opacity-0 motion-reduce:starting:translate-y-0"
    >

      <nav class="py-1.5">
        <ul>
          {
            PAGE_LINKS.map((page) => (
              <li>
                <a
                  href={page.href}
                  class="group flex items-center justify-between px-4.5 py-3.5 font-display text-2xl font-extrabold hover:bg-chip hover:text-yellow active:bg-chip"
                >
                  {page.label}
                  <svg
                    class="size-5 text-muted transition-[translate] duration-(--dur-fast) ease-(--ease-spring) group-hover:translate-x-1 group-hover:text-yellow"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M5 12h14M13 6l6 6-6 6" />
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <section aria-labelledby="find-us" class="flex flex-col gap-3 bg-raised px-3.5 pt-4 pb-4.5">
        <h2 id="find-us" class="font-display text-xs font-bold tracking-label text-muted uppercase">Find us</h2>
        <SocialLinks variant="menu" />
      </section>
    </CodeWindow>
  </dialog>
</site-menu>

<script>
  import '../../scripts/site-menu';
</script>
