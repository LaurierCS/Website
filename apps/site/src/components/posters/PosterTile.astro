---
/**
 * One poster on a drifting row: a square tile that grows a little when you point at it and opens the poster big
 * when clicked (`scripts/poster-rows.ts` fills the viewer from `data-large` and `data-event`). A `copy` is one of
 * the repeats that keep the row going round: it still opens on a click, but screen readers and the Tab key skip
 * it, since they already met the original.
 */
import { Image } from 'astro:assets';
import type { EventPoster } from '../../lib/posters';

type Props = { poster: EventPoster; large: string; copy: boolean };

const { poster, large, copy } = Astro.props;
---

<button
  type="button"
  data-tile
  data-large={large}
  data-event={poster.event}
  aria-label={copy ? undefined : `${poster.event} poster`}
  tabindex={copy ? -1 : undefined}
  class="block size-30 shrink-0 overflow-hidden rounded-xl bg-window shadow-(--shadow-card) transition-[scale] duration-(--dur-fast) ease-(--ease-spring) hover:scale-105 active:scale-97 motion-reduce:transition-none nav:size-42.5"
>
  {/* Cropped square from the top, where a poster's title is, when the site is built. */}
  <Image
    src={poster.poster}
    alt=""
    width={170}
    height={170}
    fit="cover"
    position="top"
    densities={[1, 2]}
    class="size-full object-cover object-top"
  />
</button>
