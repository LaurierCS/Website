---
/**
 * The home page's Meet the Professionals spotlight: what the event is, then one speaker at a time, their photo
 * from the event as an instant print with their card on it. The row of faces under it picks the speaker (the one
 * showing has their company's logo there instead); picking turns the card over to the next speaker, Doug focuses
 * on them through the viewfinder on the card and takes the shot, dropping a little print into the pile at his feet
 * (`scripts/speaker-spotlight.ts`). Doug stands beside the card, or on a wide screen in the space under the
 * heading, between it, the card and the ask below. Under it,
 * the ask for the next one's speakers. Without JavaScript the first speaker shows.
 */
import type { MTP } from '../../content/mtp';
import { speakerCompanies, type Speaker } from '../../lib/speakers';
import PhotoDoug from './PhotoDoug.astro';
import SpeakerFaces from './SpeakerFaces.astro';
import SpeakerPitch from './SpeakerPitch.astro';
import SpeakerSlide from './SpeakerSlide.astro';
import { DOODLE_SPOTS } from '../ui/doodle-spots';
import Doodles from '../ui/Doodles.astro';

type Props = { copy: typeof MTP; speakers: readonly Speaker[] };

const { copy, speakers } = Astro.props;

// The chips sum the speakers up: how many, and a few of the companies they came from.
const SHOWN_COMPANIES = 4;
const companies = speakerCompanies(speakers);
const moreCompanies = companies.length - SHOWN_COMPANIES;
const chips =
  speakers.length > 0
    ? [
        `${speakers.length} ${speakers.length === 1 ? 'speaker' : 'speakers'} in ${copy.edition}`,
        `${companies.slice(0, SHOWN_COMPANIES).join(' · ')}${moreCompanies > 0 ? ` +${moreCompanies} more` : ''}`,
      ]
    : [];
---

{/* Clipped at the sides, so Doug's pile of prints or a turning card never widens the page. */}
<speaker-spotlight class="group relative isolate block overflow-x-clip">
  <Doodles spots={DOODLE_SPOTS.mtp} />
  <section
    id="what-we-host"
    aria-labelledby="mtp-title"
    class="mx-auto flex max-w-(--max) flex-col px-4 py-16 nav:px-16 nav:py-24"
  >
    {/*
      On a wide screen: the heading, then Doug in the space under it, on the left; the speakers on the right,
      as tall as both.
    */}
    <div
      class:list={[
        'grid gap-10 xl:grid-cols-[1fr_auto] xl:gap-x-20',
        speakers.length > 0 && 'xl:grid-rows-[auto_1fr]',
      ]}
    >
      <header class="flex flex-col gap-4 xl:col-start-1 xl:row-start-1">
        <p class="font-display text-sm font-bold tracking-label text-yellow uppercase">{copy.label}</p>
        <h2 id="mtp-title" class="text-4xl leading-none font-extrabold text-balance nav:text-6xl">{copy.title}</h2>
        <p class="max-w-prose text-text-2 nav:text-lg">{copy.summary}</p>
        {
          chips.length > 0 && (
            <ul class="flex flex-wrap gap-2" aria-label="At a glance">
              {chips.map((chip) => (
                <li class="rounded-full bg-chip px-3.5 py-1.5 font-display text-sm font-bold">{chip}</li>
              ))}
            </ul>
          )
        }
      </header>

      {
        speakers.length > 0 && (
          /*
            Two rows shared by every speaker and the faces: the print, then the card hanging below it. The stage
            and each speaker pass the rows down (`subgrid`), so on a wider screen the faces can sit in the second
            row, right under the print and beside the card, whatever height the card is.
          */
          <div class="grid nav:w-(--print-width) nav:justify-self-center xl:col-start-2 xl:row-span-2 xl:row-start-1 xl:justify-self-end">
            <div
              role="region"
              aria-roledescription="carousel"
              aria-label="Speakers"
              data-stage
              class="relative col-start-1 row-span-2 row-start-1 grid touch-pan-y grid-rows-subgrid"
            >
              {speakers.map((speaker, index) => (
                <SpeakerSlide
                  speaker={speaker}
                  edition={copy.edition}
                  room={copy.room}
                  position={index + 1}
                  count={speakers.length}
                  shown={index === 0}
                />
              ))}
              {/* Beside the card: to its right on a phone, below the print's right end in between. */}
              <PhotoDoug class="absolute right-2 bottom-28 nav:right-4 nav:bottom-2 xl:hidden" />
            </div>
            {speakers.length > 1 && (
              <div class="col-start-1 row-start-3 mt-6 nav:row-start-2 nav:ms-(--faces-beside-card) nav:mt-4 nav:self-start">
                <SpeakerFaces speakers={speakers} />
              </div>
            )}
          </div>
        )
      }
      {
        speakers.length > 0 && (
          <PhotoDoug class="relative hidden xl:col-start-1 xl:row-start-2 xl:block xl:place-self-center" />
        )
      }
    </div>

    {/* Says who is showing after a switch, for screen readers; empty at first, so nothing is read out on load. */}
    <p data-announce class="sr-only" aria-live="polite"></p>

    <SpeakerPitch {...copy.pitch} />
  </section>
</speaker-spotlight>

<script>
  import '../../scripts/speaker-spotlight';
</script>
