---
/**
 * A speaker on a phone, as one instant print: their photo from the event, their headshot stuck on its corner like
 * a sticker, and their name, role and buttons written in the print's wide bottom margin. On a wider screen the
 * card sits beside the print instead (`SpeakerSpread`).
 */
import { Image } from 'astro:assets';
import type { Speaker } from '../../lib/speakers';
import SpeakerLinks from './SpeakerLinks.astro';

/** `shown`: the speaker showing when the page opens, whose photos load straight away instead of when needed. */
type Props = { speaker: Speaker; edition: string; room: string; shown: boolean };

const { speaker, edition, room, shown } = Astro.props;
const loading = shown ? 'eager' : 'lazy';
---

<figure data-print class="rounded-md bg-print p-2.5 pb-4 text-ink shadow-(--shadow-float)">
  <div class="relative">
    <Image
      src={speaker.eventPhoto}
      alt={`${speaker.name} at Meet the Professionals`}
      widths={[400, 760]}
      sizes="100vw"
      loading={loading}
      class="aspect-5/3 w-full rounded-sm bg-window object-cover"
    />
    <Image
      data-sticker
      src={speaker.photo}
      alt=""
      width={80}
      densities={[1, 2]}
      loading={loading}
      class="absolute -bottom-9 left-2.5 size-20 -rotate-6 rounded-full border-4 border-white bg-window object-cover object-top shadow-(--shadow-card)"
    />
  </div>
  <figcaption class="mt-12 flex flex-col gap-1 px-1">
    <div class="flex items-baseline justify-between gap-3">
      <h3 class="font-display text-2xl leading-tight font-extrabold text-balance">{speaker.name}</h3>
      <span class="shrink-0 font-display text-xs font-bold text-pink-ink">{edition} · {room}</span>
    </div>
    <p class="text-sm text-ink/80">{speaker.role} · {speaker.company}</p>
    <div class="mt-2.5 empty:hidden"><SpeakerLinks speaker={speaker} /></div>
  </figcaption>
</figure>
