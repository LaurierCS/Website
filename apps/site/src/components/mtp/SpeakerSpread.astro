---
/**
 * A speaker on a wider screen: their photo from the event as an instant print, and their speaker card laid over
 * its lower corner. On a phone the two become one print instead (`SpeakerPrint`).
 */
import { Image } from 'astro:assets';
import type { Speaker } from '../../lib/speakers';
import SpeakerLinks from './SpeakerLinks.astro';

/** `shown`: the speaker showing when the page opens, whose photos load straight away instead of when needed. */
type Props = { speaker: Speaker; edition: string; room: string; shown: boolean };

const { speaker, edition, room, shown } = Astro.props;
const loading = shown ? 'eager' : 'lazy';
---

<div class="grid">
  <figure data-print class="rounded-md bg-print p-3.5 pb-0 shadow-(--shadow-float)">
    <Image
      src={speaker.eventPhoto}
      alt={`${speaker.name} at Meet the Professionals`}
      widths={[760, 1200]}
      sizes="38rem"
      loading={loading}
      class="aspect-5/3 w-full rounded-sm bg-window object-cover"
    />
    <figcaption class="flex items-baseline justify-end gap-3 py-3.5 font-display text-ink">
      <span class="text-lg font-extrabold">Meet the Professionals · {edition}</span>
      <span class="text-sm font-bold text-pink-ink">{room}</span>
    </figcaption>
  </figure>

  <article
    data-card
    class="relative -mt-48 -ms-16 w-(--speaker-card-width) rounded-(--radius-ticket) border-4 border-yellow bg-raised p-3 shadow-(--shadow-card)"
  >
    <Image
      src={speaker.photo}
      alt=""
      width={200}
      densities={[1, 2]}
      loading={loading}
      class="aspect-4/3 w-full rounded-xl bg-window object-cover object-top"
    />
    <h3 class="mt-3 font-display text-xl leading-tight font-extrabold text-balance">{speaker.name}</h3>
    <p class="mt-0.5 text-xs text-text-2">{speaker.role} · {speaker.company}</p>
    <div class="mt-3 empty:hidden"><SpeakerLinks speaker={speaker} /></div>
  </article>
</div>
