---
/**
 * One speaker in the Meet the Professionals spotlight: their print and their card (`SpeakerSpread`), one layout
 * for every screen size.
 */
import type { Speaker } from '../../lib/speakers';
import SpeakerSpread from './SpeakerSpread.astro';

type Props = { speaker: Speaker; edition: string; room: string; position: number; count: number; shown: boolean };

const { speaker, edition, room, position, count, shown } = Astro.props;
---

{/*
  Every speaker sits in the same spot, stacked, so the spot is as tall as the tallest one and switching never
  moves the page. It takes the stage's two rows, the print's and the card's, for its spread. Only the shown one is
  visible; the others are `inert` (out of sight, of the Tab key and of screen readers) until picked
  (`scripts/speaker-spotlight.ts`). `data-name` is what a switch announces.
*/}
<div
  data-speaker
  data-name={speaker.name}
  role="group"
  aria-roledescription="slide"
  aria-label={`${position} of ${count}: ${speaker.name}`}
  inert={!shown}
  class="col-start-1 row-span-2 row-start-1 grid grid-rows-subgrid inert:invisible"
>
  <SpeakerSpread speaker={speaker} edition={edition} room={room} position={position} count={count} shown={shown} />
</div>
