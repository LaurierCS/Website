---
/**
 * The ask under the spotlight, for people who work in tech: come and speak at the next Meet the Professionals.
 * The heading is written a line at a time, so it reads as two lines rather than breaking somewhere awkward.
 */
import ButtonLink from '../ui/ButtonLink.astro';

type Props = { title: readonly string[]; text: string; action: Readonly<{ label: string; href: string }> };

const { title, text, action } = Astro.props;
---

<aside
  aria-labelledby="speaker-pitch-title"
  class="mt-10 flex flex-col gap-3 rounded-(--radius-ticket) border-2 border-yellow bg-raised px-5 py-6 nav:flex-row nav:items-center nav:gap-10 nav:px-10 nav:py-7"
>
  <h3 id="speaker-pitch-title" class="shrink-0 font-display text-2xl leading-tight font-extrabold nav:text-3xl">
    {title.map((line) => <span class="block">{line}</span>)}
  </h3>
  <p class="text-sm text-text-2 nav:flex-1 nav:text-base">{text}</p>
  <ButtonLink href={action.href} variant="primary" class="mt-1 gap-2 self-start nav:mt-0 nav:self-center">
    {action.label}
    <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
      <path d="M7 17 17 7M8 7h9v9" />
    </svg>
  </ButtonLink>
</aside>
