---
import '../styles/global.css';
import Nav from '../components/shell/Nav.astro';
import Footer from '../components/shell/Footer.astro';

interface Props {
  title?: string;
}

const { title = 'Laurier Computing Society' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Dosis:wght@500;600;700;800&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="glows" aria-hidden="true">
      <span></span><span></span><span></span><span></span><span></span>
    </div>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/nav';
      import '../scripts/scrollbar';
    </script>
  </body>
</html>
