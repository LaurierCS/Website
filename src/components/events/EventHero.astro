---
import { dateParts } from '../../lib/dates';
import { icsHref } from '../../lib/ics';
import type { EventRecord } from '../../lib/queries/events';
import { stubFor, TYPE_LABEL } from '../../lib/todo-data';

interface Props {
  event: EventRecord;
}

const { event } = Astro.props;
const parts = dateParts(event.date);
const stub = stubFor(event.id);
const live = stub && !stub.placeholder ? stub : undefined;
const mark = event.title.match(/[A-Za-z]{2,}\s?\d{2,}/)?.[0] ?? event.title.slice(0, 12);
const when = `${parts.long} · ${event.time?.trim() || 'Time TBA'} · ${event.location?.trim() || 'Location TBA'}`;
---
<section class="ev-head">
  <div class="wrap ev-head-grid">
    <div>
      <p class="crumb">
        <a href="/events">← Events</a>
        {live?.type && <> / <a href={`/events?type=${live.type}`}>{TYPE_LABEL[live.type].label}</a></>}
      </p>
      {(live?.type || live?.series || live?.streamed) && (
        <div class="pills" style="margin-top:20px">
          {live?.type && <span class:list={['pill', TYPE_LABEL[live.type].pill]}>{TYPE_LABEL[live.type].label}</span>}
          {live?.series && <span class="pill">{live.series}</span>}
          {live?.streamed && <span class="pill pink">Streamed</span>}
        </div>
      )}
      <h1>{event.title}</h1>
      <p class="ev-when">{when}</p>
      <div class="ev-ctas" id="add">
        <a class="btn btn-primary" href={icsHref(event)} download="event.ics">Add to calendar</a>
        {live?.youtubeUrl && <a class="btn btn-secondary" href={live.youtubeUrl}>Watch the stream</a>}
        <span class="muted" style="font-size:14px">Free, no sign-up needed</span>
      </div>
    </div>
    <div class="poster">
      {event.picture_url ? (
        <img class="poster-photo" src={event.picture_url} alt="" />
      ) : (
        <>
          <b>{mark}</b>
          <span>EVENT</span>
        </>
      )}
      <img class="poster-coco" data-parallax="10" src="/assets/mascots/Coco.svg" alt="" />
    </div>
  </div>
</section>
