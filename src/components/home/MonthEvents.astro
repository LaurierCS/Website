---
import Calendar from '../events/Calendar.astro';
import Ticket from '../events/Ticket.astro';
import type { EventRecord } from '../../lib/queries/events';

interface Props {
  events: EventRecord[];
  upcoming: EventRecord[];
  year: number;
  month: number;
  error: string | null;
}

const { events, upcoming, year, month, error } = Astro.props;
---
<section class="section light" id="events">
  <div class="wrap">
    <div class="sec-head" data-reveal>
      <div>
        <p class="eyebrow y">What's on</p>
        <h2 class="h-sec">Events this month</h2>
      </div>
      <a class="btn btn-secondary btn-sm" href="/events">All events + archive →</a>
    </div>
    {error && <p class="soon">{error}</p>}
    {!error && (
      <div class="events-grid">
        <Calendar events={events} year={year} month={month} />
        <div class="upnext">
          <h3>Up next</h3>
          {upcoming.length === 0 && <p class="soon">No upcoming events yet.</p>}
          {upcoming.slice(0, 2).map((event) => <Ticket event={event} />)}
        </div>
      </div>
    )}
  </div>
</section>
