---
import { YOUTUBE_URL } from '../../lib/site';
import { videoStubs } from '../../lib/todo-data';

const videos = videoStubs.filter((video) => video.url);
const featured = videos[0];
const rest = videos.slice(1, 3);
const preview = videos.some((video) => video.placeholder);
---
<section class="section light" id="videos">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <p class="eyebrow o">On YouTube</p>
        <h2 class="h-sec">Watch it back</h2>
      </div>
      <a class="btn btn-secondary btn-sm" href={YOUTUBE_URL}>Visit our channel →</a>
    </div>
    <div class="live">
      <span class="dot">COMING SOON</span>
      <p>The next stream shows up here once an event can be marked as streamed.</p>
    </div>
    {videos.length === 0 ? (
      <p class="soon">Latest videos coming soon. Nothing here is a stand-in upload.</p>
    ) : (
      <div class="vid-grid">
        {featured && (
          <a class="vid" href={featured.url}>
            <div class="vid-thumb" style={`background-image:url("${featured.thumb}")`}></div>
            <div class="vid-body">
              <span class="pill orange">Latest</span>
              <h4 style="margin-top:10px">{featured.title}</h4>
              <small>{featured.date}</small>
            </div>
          </a>
        )}
        <div class="vid-side">
          {rest.map((video) => (
            <a class="vid" href={video.url}>
              <div class="vid-thumb" style={`background-image:url("${video.thumb}")`}></div>
              <div class="vid-body"><h4>{video.title}</h4><small>{video.date}</small></div>
            </a>
          ))}
        </div>
      </div>
    )}
    {preview && <p class="note">Preview titles. These are not live channel data.</p>}
  </div>
</section>
