---
/**
 * HeroSection - Main landing hero with title and tagline
 */
---

<section id="hero" class="relative min-h-screen flex items-center justify-center py-20">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h1 class="text-5xl sm:text-6xl lg:text-7xl font-bold font-dosis mb-6 text-white">
      Laurier Computing Society
    </h1>
    <p class="text-lg sm:text-xl text-gray-300 mb-8 max-w-2xl mx-auto">
      Building community and advancing computing at Wilfrid Laurier University
    </p>
    <a
      href="#events"
      class="inline-block px-6 sm:px-8 py-3 sm:py-4 bg-lcs-pink text-white font-semibold rounded-lg hover:bg-lcs-orange transition-all transform hover:scale-105"
    >
      Explore Events
    </a>
  </div>
</section>

<style>
  section {
    position: relative;
    z-index: 10;
  }
</style>
