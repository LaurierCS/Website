---
/**
 * TeamPreview - Shows "Meet the Team" section intro
 */
---

<section id="team" class="py-20 relative z-10">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl sm:text-4xl font-bold font-dosis mb-4 text-white">Meet the Team</h2>
    <p class="text-gray-300 text-lg mb-8">
      Our dedicated team of student leaders and executives drive LCS forward every day.
    </p>
    <a
      href="/team"
      class="inline-block px-6 py-3 bg-lcs-blue text-white font-semibold rounded-lg hover:bg-lcs-light-blue hover:text-gray-900 transition-all"
    >
      View Full Team
    </a>
  </div>
</section>
