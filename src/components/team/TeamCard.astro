---
import type { TeamMember } from '../../lib/queries/team';

interface Props {
  member: TeamMember;
}

const { member } = Astro.props;
const colors = ['var(--pink)', 'var(--orange)', 'var(--yellow)', 'var(--blue)', 'var(--light-blue)'];
const color = colors[(member.id.charCodeAt(0) || 0) % colors.length] ?? colors[0];
const initial = member.name.trim().charAt(0).toUpperCase() || '?';
---
<article class="team-card" data-team-card>
  <div class="avatar" style={`--c:${color}`}>
    {member.picture_url ? (
      <img src={member.picture_url} alt="" />
    ) : (
      <span style={`color:${color}`}>{initial}</span>
    )}
  </div>
  <div>
    <h4>{member.name}</h4>
    {member.role && <p>{member.role}</p>}
    {(member.github_url || member.linkedin_url) && (
      <div class="team-links">
        {member.github_url && (
          <a href={member.github_url} target="_blank" rel="noopener noreferrer">GitHub</a>
        )}
        {member.linkedin_url && (
          <a href={member.linkedin_url} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        )}
      </div>
    )}
  </div>
</article>
<script>
  import '../../scripts/team-card';
</script>
