---
/**
 * SocialLinks - Icons linking to Discord, GitHub, LinkedIn, Instagram, Twitter
 */

const socials = [
  {
    name: 'Discord',
    url: 'https://discord.gg/YOUR_DISCORD_LINK',
    icon: 'discord',
    label: 'Discord',
  },
  {
    name: 'GitHub',
    url: 'https://github.com/LaurierCS',
    icon: 'github',
    label: 'GitHub',
  },
  {
    name: 'LinkedIn',
    url: 'https://linkedin.com/company/laurier-computing-society',
    icon: 'linkedin',
    label: 'LinkedIn',
  },
  {
    name: 'Instagram',
    url: 'https://instagram.com/lauriercs',
    icon: 'instagram',
    label: 'Instagram',
  },
  {
    name: 'Twitter',
    url: 'https://twitter.com/LaurierCS',
    icon: 'twitter',
    label: 'Twitter',
  },
];
---

<div class="social-links">
  {
    socials.map((social) => (
      <a
        href={social.url}
        aria-label={social.label}
        title={social.label}
        target="_blank"
        rel="noopener noreferrer"
        class="social-icon"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          {social.icon === 'discord' && (
            <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515a.074.074 0 0 0-.079.037c-.211.375-.444.864-.607 1.25a18.27 18.27 0 0 0-5.487 0c-.163-.386-.395-.875-.607-1.25a.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057a19.9 19.9 0 0 0 5.993 3.03a.078.078 0 0 0 .084-.028a14.975 14.975 0 0 0 1.293-2.1a.07.07 0 0 0-.038-.098a13.11 13.11 0 0 1-1.872-.892a.072.072 0 0 1-.007-.12a10.519 10.519 0 0 0 .372-.294a.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.009c.12.098.246.195.373.294a.072.072 0 0 1-.006.12a12.296 12.296 0 0 1-1.873.892a.077.077 0 0 0-.037.099a14.97 14.97 0 0 0 1.294 2.1a.076.076 0 0 0 .084.028a19.863 19.863 0 0 0 6.002-3.03a.077.077 0 0 0 .032-.057c.5-4.565-.838-8.535-3.549-12.047a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-.965-2.157-2.156c0-1.193.964-2.157 2.157-2.157c1.193 0 2.156.964 2.156 2.157c0 1.191-.963 2.156-2.156 2.156zm7.975 0c-1.183 0-2.157-.965-2.157-2.156c0-1.193.964-2.157 2.157-2.157c1.193 0 2.156.964 2.156 2.157c0 1.191-.962 2.156-2.156 2.156z" />
          )}
          {social.icon === 'github' && (
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
          )}
          {social.icon === 'linkedin' && (
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
          )}
          {social.icon === 'instagram' && (
            <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0m0 2c5.514 0 10 4.486 10 10s-4.486 10-10 10S2 17.514 2 12 6.486 2 12 2m0 1.5c-4.687 0-8.5 3.813-8.5 8.5s3.813 8.5 8.5 8.5 8.5-3.813 8.5-8.5-3.813-8.5-8.5-8.5m0 1.5c3.863 0 7 3.137 7 7s-3.137 7-7 7-7-3.137-7-7 3.137-7 7-7m2 2a1 1 0 1 0 0 2 1 1 0 0 0 0-2" />
          )}
          {social.icon === 'twitter' && (
            <path d="M23 3a10.9 10.9 0 01-3.14 1.53 4.48 4.48 0 00-7.86 3v1A10.66 10.66 0 013 4s-4 9 5 13a11.64 11.64 0 01-7 2s9 5 20 5a9.5 9.5 0 00-9-5.5c4.75 2.25 7-7 7-7a10.6 10.6 0 01-10-10.5z" />
          )}
        </svg>
      </a>
    ))
  }
</div>

<style>
  .social-links {
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  .social-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    color: white;
    transition: all 0.2s ease;
  }

  .social-icon:hover {
    color: #FF9FC4;
    transform: scale(1.15);
  }

  .social-icon svg {
    width: 100%;
    height: 100%;
  }
</style>
